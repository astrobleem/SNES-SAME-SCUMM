{
  "same_engine_profile": 1,
  "engine": "scumm_v5",
  "game": {
    "id": "monkey1-ultimate-talkie",
    "title": "The Secret of Monkey Island",
    "variant": "dos-cd-ultimate-talkie-en"
  },
  "timing": {
    "tick_hz": 60,
    "max_ops_per_tick": 4096
  },
  "video": {
    "width": 256,
    "height": 224,
    "mode": "indexed8",
    "logical_width": 320,
    "logical_height": 200
  },
  "input": {
    "profile": "scumm"
  },
  "capabilities": {
    "required": [
      "indexed8_surface",
      "dirty_rects",
      "palette_256",
      "pointer_input",
      "random_access_resources"
    ],
    "optional": [
      "tiled_video",
      "sprite_oam",
      "z_mask",
      "sa1_jobs",
      "msu1_stream",
      "audio_speech"
    ]
  },
  "resources": [
    {
      "key": "game.index",
      "path": "../../../user-data/monkey1/monkey.000",
      "kind": "SCIX"
    },
    {
      "key": "game.data",
      "path": "../../../user-data/monkey1/monkey.001",
      "kind": "SCDT",
      "streamable": true
    },
    {
      "key": "speech.archive",
      "path": "../../../user-data/monkey1/monster.sou",
      "kind": "SOU_",
      "streamable": true
    },
    {
      "key": "audio.sound_map",
      "path": "../../../user-data/monkey1/scumm_sound_map.bin",
      "kind": "SMAP"
    },
    {
      "key": "audio.speech_index",
      "path": "../../../user-data/monkey1/voice_table.bin",
      "kind": "VIDX"
    },
    {
      "key": "patches.script",
      "path": "../../../user-data/monkey1/scumm_patches.json",
      "kind": "SPAT",
      "required": false
    }
  ],
  "options": {
    "policy_schema": "scumm_v5_game_policy_v1",
    "resource_policy": {
      "format": "lucasarts_scumm_v5",
      "index_key": "game.index",
      "data_key": "game.data",
      "script_key_template": "script.{script}",
      "room_key_template": "room.{room}",
      "sound_key_template": "sound.{sound}",
      "script_patch_manifest_key": "patches.script"
    },
    "audio_policy": {
      "sound_map_key": "audio.sound_map",
      "speech_archive_key": "speech.archive",
      "speech_index_key": "audio.speech_index",
      "speech_track_base": 1000,
      "stub_sound_policy": "not_running"
    },
    "coordinate_policy": {
      "logical_width": 320,
      "logical_height": 200,
      "presentation": "host_viewport",
      "cursor_policy": "engine_default"
    },
    "copy_protection_policy": {
      "mode": "bypass",
      "script": 155,
      "answer_variable": 105,
      "answer_value": -100
    }
  },
  "quirks": {
    "monkey1.cd.silent_sound_stubs": "never_report_running",
    "monkey1.ultimate_talkie.voice_offsets": "absolute_vctl_offsets",
    "monkey1.snes.script_patch_manifest": "patches.script"
  }
}
