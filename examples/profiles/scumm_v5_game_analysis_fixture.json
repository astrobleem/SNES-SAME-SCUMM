{
  "same_engine_profile": 1,
  "engine": "scumm_v5",
  "game": {
    "id": "scumm-v5-game-analysis-fixture",
    "title": "Copyright-free whole-game analysis fixture",
    "variant": "synthetic raw v5"
  },
  "timing": {"tick_hz": 60, "max_ops_per_tick": 64},
  "video": {"width": 256, "height": 224, "mode": "indexed8",
             "logical_width": 320, "logical_height": 200},
  "input": {"profile": "scumm"},
  "capabilities": {
    "required": ["indexed8_surface", "dirty_rects", "palette_256",
                 "pointer_input", "random_access_resources"],
    "optional": []
  },
  "resources": [
    {"key": "game.index", "path": "synthetic.000", "kind": "SCIX"},
    {"key": "game.data", "path": "synthetic.001", "kind": "SCDT", "streamable": true}
  ],
  "options": {
    "policy_schema": "scumm_v5_game_policy_v1",
    "boot_script_number": 1,
    "initial_room": 1,
    "resource_policy": {
      "format": "lucasarts_scumm_v5",
      "index_key": "game.index",
      "data_key": "game.data",
      "script_key_template": "script.{script}",
      "room_key_template": "room.{room}",
      "sound_key_template": "sound.{sound}",
      "costume_key_template": "costume.{costume}",
      "charset_key_template": "charset.{charset}"
    },
    "audio_policy": {"source": "embedded", "stub_sound_policy": "not_running"},
    "coordinate_policy": {"logical_width": 320, "logical_height": 200,
                           "presentation": "host_viewport", "cursor_policy": "engine_default"},
    "copy_protection_policy": {"mode": "preserve"}
  }
}
