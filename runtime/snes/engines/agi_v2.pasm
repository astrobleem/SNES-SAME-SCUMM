; Sierra AGI v2 adapter seam.  Logic, picture, view, sound, object, parser, and
; save modules plug in here independently of the SCUMM engine.
AGI_V2_ENGINE_ID = SAME_ENGINE_AGI_V2
AGI_V2_SAVE_SCHEMA = $0001
AGI_V2_VARIABLE_COUNT = $0100
AGI_V2_FLAG_COUNT = $0100

AgiV2_Engine_Boot:
    clc
    rts
AgiV2_Engine_Frame:
    clc
    rts
AgiV2_Engine_Suspend:
    clc
    rts
AgiV2_Engine_Resume:
    clc
    rts
AgiV2_Engine_Shutdown:
    clc
    rts
