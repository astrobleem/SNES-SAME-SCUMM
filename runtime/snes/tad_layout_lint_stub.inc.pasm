; Lint-only fallback. `tools/build_snes.sh` replaces this ignored generated
; include with values parsed from the exact TAD binary before assembly.
SAME_TAD_AUDIO_DRIVER_OFFSET = $0074
SAME_TAD_AUDIO_DRIVER_SIZE   = $0C92
SAME_TAD_DATA_TABLE_OFFSET   = $0D06
SAME_TAD_ASAR_LOROM_BIAS     = $0033
SAME_TAD_DATA_ITEM_COUNT     = $0002
SAME_TAD_LAST_SONG           = $01
SAME_TAD_AUDIO_DATA_SIZE     = $1000
SAME_TAD_BLANK_OFFSET        = $8001
SAME_TAD_LOROM_SPLIT         = $8000
