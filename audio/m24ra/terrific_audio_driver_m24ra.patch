 .inline process_sfx_channels
     .assert N_SFX_CHANNELS == 2
     BOTH_SFX_ACTIVE = (1 << 7) | (1 << 6)
@@ -2321,6 +2494,19 @@ Return:
     NoMul:
     ; Y = volume
 
+    ; Apply the bounded outgoing-group gain after authored/global volume and
+    ; before pan.  Stolen B voices are removed from the A mask first.
+    mov A, sameTransitionActive
+    beq NoSameGroupGain
+    mov A, ChannelVoiceBit + X
+    and A, sameTransitionGroupAMask
+    beq NoSameGroupGain
+        mov A, sameTransitionGroupAGain
+        cmp A, #$ff
+        beq NoSameGroupGain
+        mul YA
+    NoSameGroupGain:
+
     ; Reading carry here saves a `SEC` instruction when calculating VOL_R
     mov1 C, loaderDataType, LoaderDataType__STEREO_FLAG_BIT
     bcs Stereo
@@ -4809,4 +4995,3 @@ BcStackIndexesStart:
 ValidLoopStackPointerTable:
     .dbrepeat i in 0..N_CHANNELS, (i + 1) * BC_CHANNEL_STACK_SIZE + BC_CHANNEL_STACK_OFFSET - 3 + 1
 .assert PC - ValidLoopStackPointerTable == N_CHANNELS
