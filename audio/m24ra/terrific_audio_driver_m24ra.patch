+; Synthetic M24R-A admission plan.  Incoming lanes are precompiled song
+; subroutines 0..4; this table only decides when and where they are admitted.
+; These writable bytes live in code-bank APURAM because TAD's existing
+; zero/first-page variable banks are intentionally left ABI-stable.
+sameTransitionCurrentGeneration: .db 0
+sameTransitionRequestPending: .db 0
+sameTransitionActive: .db 0
+sameTransitionTick: .db 0
+sameTransitionGroupAMask: .db 0
+sameTransitionGroupBMask: .db 0
+sameTransitionGroupAGain: .db 0
+sameTransitionStealIndex: .db 0
+sameTransitionRequestCount: .db 0
+sameTransitionStaleCount: .db 0
+sameTransitionStealCount: .db 0
+sameTransitionCompleteCount: .db 0
+sameTransitionLastEvent: .db 0
+sameTransitionAdmissionTicks:
+    .db 19, 38, 63, 94, 125
+sameTransitionAdmissionVoices:
+    .db 7, 6, 5, 4, 3
+SAME_TRANSITION_ADMISSION_COUNT = 5
+
+
+.proc same_process_layer_transition
+    mov A, sameTransitionRequestPending
+    beq NoRequest
+        mov A, #0
+        mov sameTransitionRequestPending, A
+        mov sameTransitionTick, A
+        mov sameTransitionStealIndex, A
+        mov sameTransitionGroupBMask, A
+        mov A, #1
+        mov sameTransitionActive, A
+        mov A, #$ff
+        mov sameTransitionGroupAMask, A
+        mov sameTransitionGroupAGain, A
+        inc sameTransitionRequestCount
+        mov A, #$10
+        mov sameTransitionLastEvent, A
+        mov CPUIO1, #$90
+        mov A, sameTransitionTick
+        mov CPUIO2, A
+    NoRequest:
+
+    mov A, sameTransitionActive
+    bne Active
+        ret
+    Active:
+
+    inc sameTransitionTick
+
+    ; One gain unit per 125 Hz tick: 255 ticks = 2.040 seconds.
+    mov A, sameTransitionGroupAGain
+    beq FadeComplete
+        dec sameTransitionGroupAGain
+        mov A, sameTransitionGroupAMask
+        or A, volShadowDirty_music
+        mov volShadowDirty_music, A
+
+    mov X, sameTransitionStealIndex
+    cmp X, #SAME_TRANSITION_ADMISSION_COUNT
+    bcs Return
+    mov A, sameTransitionTick
+    cmp A, sameTransitionAdmissionTicks + X
+    bne Return
+
+        ; Subroutine id equals this bounded schedule index.
+        mov zpTmp3, X
+        mov A, sameTransitionAdmissionVoices + X
+        mov X, A
+        mov A, ChannelVoiceBit + X
+        tclr1 sameTransitionGroupAMask
+        tset1 sameTransitionGroupBMask
+        tset1 keyOffShadow_music
+        tclr1 eonShadow_music
+        tclr1 pendingNon_music
+
+        ; Reset and redirect the existing channel interpreter.  No note data
+        ; or free-voice search is performed by this transition primitive.
+        mov A, #MAX_PAN / 2
+        call __reset_channel
+        mov Y, zpTmp3
+        mov A, [subroutineTable_l] + Y
+        clrc
+        adc A, songPtr.l
+        mov channelSoA_instructionPtr_l + X, A
+        mov A, [subroutineTable_h] + Y
+        adc A, songPtr.h
+        mov channelSoA_instructionPtr_h + X, A
+
+        inc sameTransitionStealIndex
+        inc sameTransitionStealCount
+        mov A, X
+        or A, #$20
+        mov sameTransitionLastEvent, A
+        or A, #$80
+        mov CPUIO1, A
+        mov A, sameTransitionTick
+        mov CPUIO2, A
+        ret
+
+    FadeComplete:
+        ; Remaining A streams reached zero.  Retire only them; B continues.
+        mov A, sameTransitionGroupAMask
+        tset1 keyOffShadow_music
+        mov Y, A
+        mov X, #0
+    DisableLoop:
+        mov A, Y
+        lsr A
+        mov Y, A
+        bcc KeepChannel
+            mov A, #0
+            mov channelSoA_instructionPtr_h + X, A
+        KeepChannel:
+        inc X
+        cmp X, #N_MUSIC_CHANNELS
+        bcc DisableLoop
+        mov A, #0
+        mov sameTransitionGroupAMask, A
+        mov sameTransitionActive, A
+        inc sameTransitionCompleteCount
+        mov A, #$3f
+        mov sameTransitionLastEvent, A
+        mov CPUIO1, #$bf
+        mov A, sameTransitionTick
+        mov CPUIO2, A
+    Return:
+    ret
+.endproc
+
